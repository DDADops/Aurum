# Install as /etc/aurum/fx.env, root:root, mode 0600. Never commit the real file.
# Bare KEY=value syntax, compatible with systemd EnvironmentFile and shell sourcing.
# oxr (default, requires key) or fawaz (keyless).
AURUM_FX_PROVIDER=oxr
AURUM_OXR_APP_ID=
# Must match the EXISTING deployment's Compose project name.
AURUM_FX_COMPOSE_PROJECT=aurum
AURUM_FX_CURRENCIES=RUB,EUR,VND,CNY
# Required: earliest completed UTC date to ingest. Choose deliberately for quota.
AURUM_FX_START_DATE=
